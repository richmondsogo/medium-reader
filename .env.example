# SQLite database path (relative or absolute)
DATABASE_PATH=./data/medium-reader.db

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Freedium Base URLs (comma separated)
FREEDIUM_BASE_URLS=https://freedium-mirror.cfd,https://freedium.cfd

# Gmail IMAP Credentials
# To generate an app password, go to Google Account -> Security -> 2-Step Verification -> App passwords.
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx